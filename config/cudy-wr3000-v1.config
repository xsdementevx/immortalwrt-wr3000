# ImmortalWrt — Cudy WR3000 v1 (MT7981B) — MINIMAL BUILD
# WiFi + Xray + PassWall2, nothing else
#
# FLASH: 16 MB SPI NOR, IMAGE_SIZE = 15424k (~15 MB)
# RAM: 256 MB DDR3L
#
# xray-core baked into squashfs — no network download on boot

# ── Target ────────────────────────────────────────────────────────────────────
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_wr3000-v1=y

# ── Build: strip everything, squashfs only ────────────────────────────────────
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_DEBUG is not set
CONFIG_USE_STRIP=y
CONFIG_STRIP_ARGS="--strip-all"
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ── WiFi (mandatory for WR3000) ──────────────────────────────────────────────
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y

# ── LuCI (minimal — just enough for passwall2 UI) ────────────────────────────
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y

# ── PassWall2 — ONLY xray, disable all other cores ──────────────────────────
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# Explicitly disable all passwall2 optional includes
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowTLS=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_SingBox=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_tuic_client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_IPv6_Nat=n

# ── Xray-core — THE KEY PACKAGE ──────────────────────────────────────────────
CONFIG_PACKAGE_xray-core=y

# ── PassWall2 minimal runtime deps ───────────────────────────────────────────
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y

# ── nftables transparent proxy (required by passwall2 + fw4) ─────────────────
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y

# ── DNS: let ImmortalWrt default (dnsmasq-full) ──────────────────────────────
# Don't set dnsmasq or dnsmasq-full explicitly — they conflict if both are set

# ── SSH ───────────────────────────────────────────────────────────────────────
CONFIG_PACKAGE_dropbear=y

# ── TLS (xray needs OpenSSL) ─────────────────────────────────────────────────
CONFIG_PACKAGE_libopenssl=y

# ── Explicitly disable everything passwall2 might pull in ────────────────────
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-local is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-redir is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-server is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-tunnel is not set
# CONFIG_PACKAGE_shadowsocks-libev-config is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-local is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-server is not set
# CONFIG_PACKAGE_v2ray-plugin is not set
# CONFIG_PACKAGE_xray-plugin is not set
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_naiveproxy is not set
# CONFIG_PACKAGE_haproxy is not set
# CONFIG_PACKAGE_simple-obfs is not set
# CONFIG_PACKAGE_trojan-plus is not set
# CONFIG_PACKAGE_shadow-tls is not set
# CONFIG_PACKAGE_tuic-client is not set
# CONFIG_PACKAGE_chinadns-ng is not set
# CONFIG_PACKAGE_dns2socks is not set
# CONFIG_PACKAGE_ipt2socks is not set
# CONFIG_PACKAGE_microsocks is not set
# CONFIG_PACKAGE_geoview is not set
# CONFIG_PACKAGE_v2ray-geoip is not set
# CONFIG_PACKAGE_v2ray-geosite is not set

# ── EVERYTHING ELSE: OFF ─────────────────────────────────────────────────────
# No IPv6
# CONFIG_PACKAGE_ipv6helper is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_kmod-ip6tables is not set
# No PPPoE
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_kmod-pppoe is not set
# CONFIG_PACKAGE_kmod-pppox is not set
# CONFIG_PACKAGE_luci-proto-ppp is not set
# No extras
# CONFIG_PACKAGE_wget-ssl is not set
# CONFIG_PACKAGE_ca-certificates is not set
# CONFIG_PACKAGE_unzip is not set
# CONFIG_PACKAGE_tcping is not set
# CONFIG_PACKAGE_coreutils-base64 is not set
# CONFIG_PACKAGE_coreutils-nohup is not set
# CONFIG_PACKAGE_luci-app-opkg is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_luci-app-adblock is not set
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_bash is not set
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_htop is not set
# CONFIG_PACKAGE_openssh-sftp-server is not set
# CONFIG_PACKAGE_tc-full is not set
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_kmod-wireguard is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_ntp is not set
