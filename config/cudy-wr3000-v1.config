# ImmortalWrt — Cudy WR3000 v1 — ULTRA MINIMAL
# WiFi + LuCI + nftables. Xray is embedded as compressed data file.
# No passwall2, no xray package — xray binary built separately.
#
# FLASH: 16 MB SPI NOR, IMAGE_SIZE ~15 MB
# Target squashfs budget: ~9-10 MB (leaves ~5 MB for xray.xz data)

# ── Target ────────────────────────────────────────────────────────────────────
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_wr3000-v1=y

# ── Build optimization ───────────────────────────────────────────────────────
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_DEBUG is not set
CONFIG_USE_STRIP=y
CONFIG_STRIP_ARGS="--strip-all"
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ── WiFi (mandatory) ─────────────────────────────────────────────────────────
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y

# ── LuCI (minimal — WiFi and firewall management) ────────────────────────────
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y

# ── nftables (for xray transparent proxy redirect) ───────────────────────────
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y

# ── SSH ───────────────────────────────────────────────────────────────────────
CONFIG_PACKAGE_dropbear=y

# ── TLS (xray needs it at runtime) ───────────────────────────────────────────
CONFIG_PACKAGE_ca-bundle=y

# ── Utilities needed by xray init script ─────────────────────────────────────
CONFIG_PACKAGE_xz-utils=y

# ── EVERYTHING ELSE: OFF ─────────────────────────────────────────────────────
# No passwall2
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# No xray/sing-box packages (xray is embedded as compressed file)
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_sing-box is not set
# No IPv6
# CONFIG_PACKAGE_ipv6helper is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# No PPPoE
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_kmod-pppoe is not set
# CONFIG_PACKAGE_kmod-pppox is not set
# CONFIG_PACKAGE_luci-proto-ppp is not set
# No extras
# CONFIG_PACKAGE_luci-app-opkg is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_bash is not set
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_htop is not set
# CONFIG_PACKAGE_ntp is not set
